<?xml version="1.0" encoding="utf-8"?>
<!-- Interrupteur figé (widget verrouillé) : allumé, atténué pour montrer qu'il ne réagit pas -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="4dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="#80FF4FA0" />
        </shape>
    </item>
    <item android:left="18dp" android:top="2dp" android:bottom="2dp" android:right="2dp">
        <shape android:shape="oval">
            <solid android:color="#CCFFFFFF" />
        </shape>
    </item>
</layer-list>
