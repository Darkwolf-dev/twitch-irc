# Secret exigé par l'API (au moins 32 caractères). Pour en générer un : npm run secret
API_SECRET=

# Laisser 127.0.0.1 : l'accès à distance passe par Tailscale (tailscale serve 3000)
HOST=127.0.0.1
PORT=3000
MAX_CHANNELS=100

# Connexion au panneau avec Twitch : logins autorisés, séparés par des virgules (vide = désactivée).
# Ajouter https://<ton-domaine>/ dans les « OAuth Redirect URLs » de l'appli Twitch.
# ALLOWED_LOGINS=darkwolfy
# Cookie de session « Secure » (mettre false seulement pour tester en http hors localhost)
# COOKIE_SECURE=true

# Surveillance : adresse de ping healthchecks.io (Period 1 min, Grace 5 min)
# HEALTHCHECK_URL=https://hc-ping.com/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Hébergement en ligne
# Nom de domaine pour docker compose + Caddy (HTTPS automatique)
# DOMAIN=irc.ton-domaine.fr
# Ou bien Cloudflare Tunnel (docker-compose.tunnel.yml) : jeton du tunnel
# TUNNEL_TOKEN=
# Derrière Cloudflare uniquement : en-tête contenant la vraie IP du client
# CLIENT_IP_HEADER=cf-connecting-ip
# Dossier persistant pour token.json et channels.json (défaut : ./data)
# DATA_DIR=/data
# Nombre de reverse proxys devant l'app (1 derrière Caddy/Nginx ou la plupart des PaaS)
# TRUST_PROXY=1

# --- Authentification Twitch : choisir A ou B ---

# A (recommandé) : application Twitch de type "Public" sur https://dev.twitch.tv/console/apps
# puis lancer "npm run auth". Le token est stocké dans data/token.json et renouvelé automatiquement.
TWITCH_CLIENT_ID=
# Uniquement pour une application de type "Confidential" :
# TWITCH_CLIENT_SECRET=

# B : token utilisateur fixe avec le scope chat:read (aucun renouvellement automatique)
# TWITCH_OAUTH_TOKEN=
